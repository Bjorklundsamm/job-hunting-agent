# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# note_to_self: the agent links to YOUR Signal account and talks to you in "Note to Self".
# bot: the agent has its own number (SIGNAL_BOT_NUMBER) and messages you.
# console: print messages instead of sending (testing).
SIGNAL_MODE=note_to_self
SIGNAL_USER_NUMBER=+1XXXXXXXXXX
# SIGNAL_BOT_NUMBER=+1XXXXXXXXXX
# macOS example; on Windows use the full path to signal-cli.bat that windows\setup.ps1 prints.
SIGNAL_CLI_PATH=/Users/aloof/.local/bin/signal-cli
